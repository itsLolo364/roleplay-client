{
  "name": "roleplay-client",
  "version": "v0.2.3-beta",
  "description": "Roleplay Client - Minecraft Launcher",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/clean-blockers.ps1",
    "build": "electron-builder",
    "prebuild:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/clean-blockers.ps1",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux --x64",
    "pack": "electron-builder --dir",
    "package:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-installer.ps1",
    "package:installer:quick": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-installer.ps1 -SkipMod",
    "package:linux": "bash ./scripts/package-linux.sh",
    "package:linux:quick": "bash ./scripts/package-linux.sh --skip-mod",
    "publish": "node scripts/publish.js"
  },
  "author": {
    "name": "Giovyx90",
    "email": "giovannii.albanese04@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LoloCass/LoloClient"
  },
  "publish": {
    "provider": "github",
    "releaseType": "release"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.16.8",
    "msmc": "^5.0.5"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.roleplayclient.minecraft",
    "productName": "Roleplay Client",
    "copyright": "Copyright © LoloCass",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "public/**/*",
      "lib/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "RoleplayClient-Setup-${version}.${ext}",
      "signAndEditExecutable": false,
      "signingHashAlgorithms": []
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Game",
      "synopsis": "Roleplay Client - Minecraft Launcher",
      "artifactName": "RoleplayClient-${version}-linux-${arch}.${ext}",
      "executableName": "roleplay-client"
    },
    "deb": {
      "packageName": "roleplay-client",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Roleplay Client",
      "uninstallDisplayName": "Roleplay Client",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "menuCategory": "Games"
    }
  }
}
